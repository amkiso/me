# Server Config
PORT=3000
NODE_ENV=production

# Base URL gốc của hệ thống
BASE_URL=http://localhost

# CẤU HÌNH ĐƯỜNG DẪN REDIRECT & CALLBACK (Dễ dàng thay đổi khi deploy lên server thật)
# ----------------------------------------------------------------------------------
# 1. Đường dẫn chuyển hướng khi Đăng nhập Thành công (Admin):
REDIRECT_SUCCESS_URL=http://localhost/admin/

# 2. Đường dẫn chuyển hướng khi Đăng nhập Thất bại (Từ chối truy cập):
REDIRECT_FAILURE_URL=http://localhost/?access=denied

# 3. Đường dẫn Callback OAuth (Khớp 100% với cấu hình trên Google / GitHub Console):
GITHUB_CALLBACK_URL=http://localhost/api/auth/github/callback
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback

# JWT & Session Secrets
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
SESSION_SECRET=change-this-session-secret-too

# Danh sách Email được phép làm Admin
ADMIN_USERS=hoangvu2004dl@gmail.com,thangcuoi1984a@gmail.com

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
